+      // de-dupe in case the same alert id arrives twice (e.g. hydrate race) and
+      // collapse a repeat of the SAME alert title: the GPS / field-map sync
+      // messages repeat for as long as the condition lasts, and the operator
+      // does not want a counter that climbs while nobody is looking.
+      next.alerts = [
+        entry,
+        ...state.alerts.filter((a) => a.id !== entry.id && !(a.title === entry.title && !a.acknowledgedAt)),
+      ].slice(0, 100);
