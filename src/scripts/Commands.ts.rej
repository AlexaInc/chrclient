-export const returnToBase = () => sendCommand({ action: 'return_to_base' });
+export const returnToBase = (reason = 'operator') =>
+  sendCommand({ action: 'return_to_base', data: { reason } });
+
+/**
+ * Report a raindrop. chrserver answers with the full rain sequence — water pump
+ * OFF (and locked off while it rains), robot back to its base point, and an
+ * alert to every owner number. The firmware reports the same event by itself the
+ * moment its own rain sensor trips, so this is for an operator who sees the rain
+ * first (or for a build without the sensor wired yet).
+ */
+export const reportRainDrop = (rainPercent?: number, source: 'sensor' | 'operator' = 'operator') =>
+  sendCommand({ action: 'report_rain', data: { source, rainPercent } });
+
+/**
+ * Petrol-empty report. The rover has no fuel gauge, so the operator (or the
+ * firmware's run-hour counter) reports the empty tank and the server sends the
+ * report to all owner numbers.
+ */
+export const reportFuelEmpty = (note?: string, runMinutes?: number) =>
+  sendCommand({ action: 'report_fuel_empty', data: { note, runMinutes } });
 export const setManualTeleop = (enabled: boolean) =>
   sendCommand({ action: 'manual_teleop', data: { enabled } });
