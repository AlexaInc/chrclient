+/**
+ * Auto-watering threshold for ONE well. The soil-moisture probe sits on the
+ * water pump (the rover has none), so this value is stored per pump — pass the
+ * pump's deviceId, or a blockId when the well feeds a mapped block.
+ */
+export const setIrrigationThreshold = (moisturePercent: number, pumpId?: string, blockId?: string) =>
