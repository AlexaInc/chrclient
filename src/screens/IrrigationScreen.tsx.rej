 import { useRealtime } from '../realtime/RealtimeContext';
 import { useCommand } from '../hooks/useCommand';
 import { pumpOn, pumpOff, setPumpAuto, setIrrigationThreshold, irrigateBlock } from '../scripts/Commands';
 import ActionFeedback from '../components/ActionFeedback';
+import { readPref, writePref } from '../state/deviceStorage';
+
+/**
+ * Water pump / irrigation screen.
+ *
+ * Two things the operator asked for live here:
+ *
+ *  1. PUMP ON is no longer locked to 60 seconds. 60 s is still the default, but
+ *     the duration is adjustable (and remembered on the device), and the button
+ *     always says how long the pump will really run.
+ *
+ *  2. AUTO MOISTURE THRESHOLD is a PER-WELL setting. The rover carries no
+ *     soil-moisture sensor at all — the probe sits on the water pump — so the
+ *     threshold belongs to the pump/well, not to the robot. A farm running two
+ *     wells can therefore dry-farm one block and keep another wet without
+ *     touching the robot's configuration.
+ */
+
+const DURATION_KEY = 'chrclient.pump.durationSeconds';
+const THRESHOLD_KEY = 'chrclient.pump.wellThresholds';
+const DEFAULT_DURATION = 60;
+const PRESETS = [30, 60, 120, 300];
+const THRESHOLD_CHOICES = [25, 35, 45, 55];
+const MIN_DURATION = 15;
+const MAX_DURATION = 900;
+
+function clampDuration(value: number): number {
+  if (!Number.isFinite(value)) return DEFAULT_DURATION;
+  return Math.max(MIN_DURATION, Math.min(MAX_DURATION, Math.round(value)));
+}
+
+function readThresholds(): Record<string, number> {
+  const raw = readPref(THRESHOLD_KEY);
+  if (!raw) return {};
+  try {
+    const parsed = JSON.parse(raw);
+    return parsed && typeof parsed === 'object' ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+/** Quick duration picker: presets plus a fine stepper, clamped to 15 s … 15 min. */
+function DurationPicker({ value, onChange }: { value: number; onChange: (next: number) => void }) {
+  return (
+    <View className="mt-3">
+      <Row className="justify-between">
+        <Text className="text-[11px] font-extrabold text-slate-700 dark:text-slate-200">PUMP RUN DURATION</Text>
+        <Text className="text-[11px] font-extrabold text-brand-700 dark:text-brand-300">{value}s</Text>
+      </Row>
+      <Row className="gap-2 mt-2">
+        {PRESETS.map((preset) => (
+          <TouchableOpacity
+            key={preset}
+            onPress={() => onChange(preset)}
+            className={`flex-1 rounded-lg py-2 ${value === preset ? 'bg-brand-600' : 'bg-slate-100 dark:bg-slate-800'}`}
+          >
+            <Text className={`text-center text-[11px] font-extrabold ${value === preset ? 'text-white' : 'text-slate-600 dark:text-slate-300'}`}>
+              {preset}s
+            </Text>
+          </TouchableOpacity>
+        ))}
+      </Row>
+      <Row className="gap-2 mt-2">
+        <TouchableOpacity
+          onPress={() => onChange(clampDuration(value - 15))}
+          className="border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 items-center justify-center"
+        >
+          <Feather name="minus" size={14} color={colors.slate500} />
+        </TouchableOpacity>
+        <View className="flex-1 border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 items-center justify-center">
+          <Text className="text-[12px] font-extrabold text-slate-700 dark:text-slate-200">
+            {value} seconds {value === DEFAULT_DURATION ? '· default' : ''}
+          </Text>
+        </View>
+        <TouchableOpacity
+          onPress={() => onChange(clampDuration(value + 15))}
+          className="border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 items-center justify-center"
+        >
+          <Feather name="plus" size={14} color={colors.slate500} />
+        </TouchableOpacity>
+      </Row>
+      <Text className="text-[10px] text-slate-400 mt-1.5">
+        Any value from {MIN_DURATION}s to {MAX_DURATION}s. The pump still stops by itself when the timer ends, and STOP
+        always cuts it immediately.
+      </Text>
+    </View>
+  );
+}
 
 export default function IrrigationScreen() {
   const { irrigation, fieldMap, devices } = useRealtime();
